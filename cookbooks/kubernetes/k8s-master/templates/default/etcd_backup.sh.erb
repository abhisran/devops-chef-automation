#!/bin/bash
# Managed by Chef - k8s-master::etcd_backup recipe
# etcd snapshot backup with local + remote retention
set -euo pipefail

BACKUP_DIR="<%= @backup_dir %>"
RETENTION_DAYS="<%= @retention_days %>"
ETCD_ENDPOINTS="<%= @etcd_endpoints %>"
CERT_DIR="<%= @cert_dir %>"
REMOTE_ENABLED="<%= @remote_enabled %>"
REMOTE_USER="<%= @remote_user %>"
REMOTE_HOST="<%= @remote_host %>"
REMOTE_PATH="<%= @remote_path %>"
REMOTE_RETENTION_DAYS="<%= @remote_retention_days %>"

TIMESTAMP=$(date +%Y-%m-%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/etcd-backup-${TIMESTAMP}.db"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

verify_latest() {
  local latest
  latest=$(find "${BACKUP_DIR}" -name 'etcd-backup-*.db' -type f | sort | tail -1)
  if [ -z "${latest}" ]; then
    log "ERROR: No backup files found in ${BACKUP_DIR}"
    exit 1
  fi
  log "Verifying latest backup: ${latest}"
  ETCDCTL_API=3 etcdctl snapshot status "${latest}" --write-out=table
  log "Verification complete."
}

if [ "${1:-}" = "--verify" ]; then
  verify_latest
  exit 0
fi

log "Starting etcd backup..."

ETCDCTL_API=3 etcdctl snapshot save "${BACKUP_FILE}" \
  --endpoints="${ETCD_ENDPOINTS}" \
  --cacert="${CERT_DIR}/ca.crt" \
  --cert="${CERT_DIR}/server.crt" \
  --key="${CERT_DIR}/server.key"

log "Snapshot saved to ${BACKUP_FILE}"

log "Verifying snapshot integrity..."
ETCDCTL_API=3 etcdctl snapshot status "${BACKUP_FILE}" --write-out=table

log "Rotating local backups older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -name 'etcd-backup-*.db' -type f -mtime "+${RETENTION_DAYS}" -delete
REMAINING=$(find "${BACKUP_DIR}" -name 'etcd-backup-*.db' -type f | wc -l)
log "Local backups remaining: ${REMAINING}"

if [ "${REMOTE_ENABLED}" = "true" ]; then
  log "Copying backup to ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}/"
  ssh -o StrictHostKeyChecking=no "${REMOTE_USER}@${REMOTE_HOST}" "mkdir -p ${REMOTE_PATH}"
  scp -o StrictHostKeyChecking=no "${BACKUP_FILE}" "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PATH}/"

  log "Rotating remote backups older than ${REMOTE_RETENTION_DAYS} days..."
  ssh -o StrictHostKeyChecking=no "${REMOTE_USER}@${REMOTE_HOST}" \
    "find ${REMOTE_PATH} -name 'etcd-backup-*.db' -type f -mtime +${REMOTE_RETENTION_DAYS} -delete"
  log "Remote copy complete."
fi

log "etcd backup finished successfully."
