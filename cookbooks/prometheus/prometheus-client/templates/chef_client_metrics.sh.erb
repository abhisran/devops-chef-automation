#!/bin/bash
# Chef client metrics collector for Prometheus node_exporter textfile collector
# Auto-generated by Chef - Do not edit manually

PROM_FILE="<%= @textfile_dir %>/chef_client.prom"
TEMP_FILE="${PROM_FILE}.$$"

# Check if chef-client.timer is active
if systemctl is-active --quiet chef-client.timer 2>/dev/null; then
  TIMER_ACTIVE=1
else
  TIMER_ACTIVE=0
fi

# Check last run status via systemd service result
RESULT=$(systemctl show chef-client.service --property=Result --value 2>/dev/null)
if [ "$RESULT" = "success" ]; then
  RUN_SUCCESS=1
else
  RUN_SUCCESS=0
fi

# Get last run timestamp from log file modification time
LOG="/var/log/chef/client.log"
if [ -f "$LOG" ]; then
  LAST_RUN=$(stat -c %Y "$LOG" 2>/dev/null || echo 0)
else
  LAST_RUN=0
fi

cat > "$TEMP_FILE" << EOF
# HELP chef_client_timer_active Whether the chef-client systemd timer is active (1=active, 0=inactive).
# TYPE chef_client_timer_active gauge
chef_client_timer_active $TIMER_ACTIVE
# HELP chef_client_last_run_success Whether the last chef-client run succeeded (1=success, 0=failed).
# TYPE chef_client_last_run_success gauge
chef_client_last_run_success $RUN_SUCCESS
# HELP chef_client_last_run_timestamp_seconds Epoch timestamp of the last chef-client run attempt.
# TYPE chef_client_last_run_timestamp_seconds gauge
chef_client_last_run_timestamp_seconds $LAST_RUN
EOF

mv "$TEMP_FILE" "$PROM_FILE"
