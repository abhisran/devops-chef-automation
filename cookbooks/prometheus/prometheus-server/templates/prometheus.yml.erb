# Prometheus Configuration
# Auto-generated by Chef - Do not edit manually

global:
  scrape_interval: <%= @scrape_interval %>
  evaluation_interval: <%= @evaluation_interval %>
  scrape_timeout: <%= @scrape_timeout %>

<% if @alert_rules_enabled -%>
rule_files:
  - "rules/*.yml"
<% end -%>

<% if @alertmanager_enabled -%>
alerting:
  alertmanagers:
    - static_configs:
        - targets:
<% @alertmanager_targets.each do |target| -%>
            - "<%= target %>"
<% end -%>
<% end -%>

scrape_configs:
<% @scrape_configs.each do |config| -%>
  - job_name: "<%= config['job_name'] %>"
<% if config['metrics_path'] -%>
    metrics_path: "<%= config['metrics_path'] %>"
<% end -%>
<% if config['scheme'] -%>
    scheme: "<%= config['scheme'] %>"
<% end -%>
<% if config['scrape_interval'] -%>
    scrape_interval: <%= config['scrape_interval'] %>
<% end -%>
<% if config['bearer_token_file'] -%>
    bearer_token_file: "<%= config['bearer_token_file'] %>"
<% end -%>
<% if config['tls_config'] -%>
    tls_config:
<% if config['tls_config']['insecure_skip_verify'] -%>
      insecure_skip_verify: true
<% end -%>
<% if config['tls_config']['ca_file'] -%>
      ca_file: "<%= config['tls_config']['ca_file'] %>"
<% end -%>
<% if config['tls_config']['cert_file'] -%>
      cert_file: "<%= config['tls_config']['cert_file'] %>"
<% end -%>
<% if config['tls_config']['key_file'] -%>
      key_file: "<%= config['tls_config']['key_file'] %>"
<% end -%>
<% end -%>
    static_configs:
      - targets:
<% config['targets'].each do |target| -%>
          - "<%= target %>"
<% end -%>
<% if config['labels'] -%>
        labels:
<% config['labels'].each do |key, value| -%>
          <%= key %>: "<%= value %>"
<% end -%>
<% end -%>

<% end -%>
