# Prometheus Alert Rules
# Auto-generated by Chef - Do not edit manually

groups:
<% @groups.each do |group| -%>
  - name: <%= group['name'] %>
    rules:
<% group['rules'].each do |rule| -%>
      - alert: <%= rule['alert'] %>
        expr: '<%= rule['expr'] %>'
        for: <%= rule['for'] %>
        labels:
<% rule['labels'].each do |key, value| -%>
          <%= key %>: "<%= value %>"
<% end -%>
        annotations:
<% rule['annotations'].each do |key, value| -%>
          <%= key %>: "<%= value %>"
<% end -%>
<% end -%>

<% end -%>
