# Alertmanager configuration
# Auto-generated by Chef - Do not edit manually

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default-receiver'

receivers:
- name: 'default-receiver'
<% if @telegram_enabled && @telegram_token && @telegram_chat_id -%>
  telegram_configs:
  - bot_token: '<%= @telegram_token %>'
    chat_id: <%= @telegram_chat_id.to_i %>
    send_resolved: true
    parse_mode: 'HTML'
    message: |
      <b>Alert:</b> {{ .GroupLabels.alertname }}
      <b>Instance:</b> {{ .GroupLabels.instance }}
      <b>Severity:</b> {{ .CommonLabels.severity }}
      <b>Summary:</b> {{ .CommonAnnotations.summary }}
      <b>Description:</b> {{ .CommonAnnotations.description }}
<% else -%>
  # No receiver configured, alerts will be logged
<% end -%>

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
