jenkins:
  systemMessage: "Jenkins configured by Chef - Configuration as Code"
  numExecutors: <%= @controller_executors %>
<% unless @agents.empty? || @ssh_private_key.to_s.strip.empty? -%>
  nodes:
<% @agents.each do |agent| -%>
    - permanent:
        name: "<%= agent['name'] %>"
        remoteFS: "<%= agent['work_dir'] %>"
        numExecutors: <%= agent['executors'] %>
        labelString: "<%= agent['label'] %>"
        nodeDescription: "<%= agent['description'] %>"
        retentionStrategy: "always"
        launcher:
          ssh:
            host: "<%= agent['host'] %>"
            port: 22
            credentialsId: "jenkins-agent-ssh-key"
            sshHostKeyVerificationStrategy: "nonVerifyingKeyVerificationStrategy"
            javaPath: "<%= agent['java_path'] || '/usr/bin/java' %>"
<% end -%>
<% end -%>
  clouds:
    - kubernetes:
        name: "Home-Kubernetes"
        serverUrl: "https://192.168.1.71:6443"
        namespace: "ci-cd"
        jenkinsUrl: "<%= @jenkins_url %>"
        credentialsId: "k8s-jenkins-token"
        skipTlsVerify: true
        webSocket: true
        templates:
          - name: "k8s-agent"
            label: "k8s-agent"
            containers:
              - name: "jnlp"
                image: "jenkins/inbound-agent:latest"
                envVars:
                  - envVar:
                      key: "GIT_SSH_COMMAND"
                      value: "ssh -o StrictHostKeyChecking=no"

credentials:
  system:
    domainCredentials:
      - credentials:
<% unless @agents.empty? || @ssh_private_key.to_s.strip.empty? -%>
          - basicSSHUserPrivateKey:
              scope: SYSTEM
              id: "jenkins-agent-ssh-key"
              description: "SSH key for Jenkins agent connectivity"
              username: "jenkins"
              privateKeySource:
                directEntry:
                  privateKey: |
<% @ssh_private_key.each_line do |line| -%>
                    <%= line.rstrip %>
<% end -%>
<% end -%>
<% unless @k8s_token.to_s.strip.empty? -%>
          - string:
              scope: SYSTEM
              id: "k8s-jenkins-token"
              description: "Kubernetes ServiceAccount token for jenkins-deployer"
              secret: "<%= @k8s_token %>"
<% end -%>
<% unless @github_private_key.to_s.strip.empty? -%>
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "github-ssh-key"
              description: "SSH key for GitHub access"
              username: "git"
              privateKeySource:
                directEntry:
                  privateKey: |
<% # Handle both literal newlines and escaped \n strings, then indent each line by 20 spaces
   normalized_key = @github_private_key.to_s.gsub('\n', "\n")
   normalized_key.each_line do |line| -%>
                    <%= line.rstrip %>
<% end -%>
<% end -%>

unclassified:
  location:
    url: "<%= @jenkins_url %>"
  gitSCM:
    gitHostKeyVerificationConfiguration:
      sshHostKeyVerificationStrategy: "acceptFirstConnection"

