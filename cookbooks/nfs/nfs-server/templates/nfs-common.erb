# /etc/default/nfs-common
# This file is generated by Chef. Manual changes will be overwritten.

# If you do not wish to start rpc.gssd and rpc.svcgssd, set this to "no"
NEED_GSSD=

# Options for rpc.statd.
#   Keep rpc.statd from listening on a random port.
STATDOPTS="--port <%= node['nfs']['server']['ports']['statd'] %> --outgoing-port <%= node['nfs']['server']['ports']['statd'] + 1 %>"

# Do you want to start the idmapd daemon? It is only needed for NFSv4.
NEED_IDMAPD=

# Do you want to start the gssd daemon? It is required for Kerberos mounts.
NEED_GSSD=
