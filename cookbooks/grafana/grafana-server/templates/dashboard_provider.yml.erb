# Grafana Dashboard Provisioning
# Auto-generated by Chef - Do not edit manually
#
# Place dashboard JSON files in <%= @dashboard_dir %>
# Grafana will automatically import them on startup/reload.

apiVersion: 1

providers:
  - name: 'chef-managed'
    orgId: 1
    folder: ''
    type: file
    disableDeletion: false
    editable: true
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: <%= @dashboard_dir %>
      foldersFromFilesStructure: false
