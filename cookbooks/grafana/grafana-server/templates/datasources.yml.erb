# Grafana Datasource Provisioning
# Auto-generated by Chef - Do not edit manually

apiVersion: 1

datasources:
<% @datasources.each do |ds| -%>
  - name: "<%= ds['name'] %>"
    type: <%= ds['type'] %>
    access: <%= ds['access'] %>
    url: <%= ds['url'] %>
    isDefault: <%= ds['is_default'] ? 'true' : 'false' %>
    editable: <%= ds['editable'] ? 'true' : 'false' %>
    version: 1
    uid: <%= ds['name'].downcase.gsub(/[^a-z0-9]/, '-') %>
<% end -%>
