# Grafana Configuration
# Auto-generated by Chef - Do not edit manually

[paths]
data = <%= @data_dir %>
logs = <%= @log_dir %>
plugins = <%= @data_dir %>/plugins
provisioning = <%= @provisioning_dir %>

[server]
http_addr = <%= @http_addr %>
http_port = <%= @http_port %>
domain = <%= @domain %>
root_url = <%= @root_url %>

[database]
type = sqlite3

[security]
admin_user = <%= @admin_user %>
admin_password = <%= @admin_password %>

[users]
allow_sign_up = false

[auth.anonymous]
enabled = <%= @anonymous_enabled %>
org_role = <%= @anonymous_org_role %>

[analytics]
reporting_enabled = <%= @reporting_enabled %>
check_for_updates = <%= @check_for_updates %>

[metrics]
enabled = <%= @metrics_enabled %>

[log]
mode = <%= @log_mode %>
level = <%= @log_level %>

[unified_alerting]
enabled = true
