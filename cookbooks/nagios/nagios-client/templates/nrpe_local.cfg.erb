# Memory check using free command (no external plugin required)
# Warn at 80% used, Critical at 90% used
command[check_mem]=/bin/bash -c 'TOTAL=$(free -m | awk "/^Mem:/{print \$2}"); USED=$(free -m | awk "/^Mem:/{print \$3}"); PCT=$((USED*100/TOTAL)); if [ $PCT -ge <%= @mem_crit || 90 %> ]; then echo "CRITICAL: Memory usage ${PCT}% (${USED}MB/${TOTAL}MB)"; exit 2; elif [ $PCT -ge <%= @mem_warn || 80 %> ]; then echo "WARNING: Memory usage ${PCT}% (${USED}MB/${TOTAL}MB)"; exit 1; else echo "OK: Memory usage ${PCT}% (${USED}MB/${TOTAL}MB)"; exit 0; fi'

