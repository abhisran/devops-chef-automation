# Nagios Host, Hostgroup, and Service Definitions
# Auto-generated by Chef - Do not edit manually

###############################################################################
# Hostgroup Definitions
###############################################################################

<% node['nagios']['hostgroups'].each do |group| %>
define hostgroup {
    hostgroup_name          <%= group['name'] %>
    alias                   <%= group['alias'] %>
}

<% end %>
###############################################################################
# Host Definitions
###############################################################################

<% node['nagios']['monitored_hosts'].each do |host| %>
define host {
    use                     linux-server
    host_name               <%= host['host_name'] %>
    alias                   <%= host['alias'] %>
    address                 <%= host['address'] %>
<% if host['hostgroups'] && !host['hostgroups'].empty? %>
    hostgroups              <%= host['hostgroups'].join(',') %>
<% end %>
    max_check_attempts      5
    check_period            24x7
    notification_interval   30
    notification_period     24x7
}

<% end %>
###############################################################################
# Service Definitions (by Hostgroup)
###############################################################################

<% node['nagios']['hostgroup_services'].each do |hostgroup, services| %>
# Services for hostgroup: <%= hostgroup %>
<% services.each do |service| %>
define service {
    use                     generic-service
    hostgroup_name          <%= hostgroup %>
    service_description     <%= service['description'] %>
    check_command           <%= service['check_command'] %>
}

<% end %>
<% end %>
